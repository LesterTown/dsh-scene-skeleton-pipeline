{
  "$schema": "dsh-scene-skeleton-pipeline/asset-library@1",
  "version": 1,
  "note": "语义资产库：plan_scene_layout 的 type 白名单 + 尺寸范围 + 程序化几何定义（唯一事实源）。新增 type 只需在这里加条目，并在 run_scenic.py 的 _build_geometry_part 支持所需 primitive；材质可选 albedo/normal/roughness/metallic 贴图路径（相对 assetLibraryPath，缺失回退纯色）。每个 type 可选 modelPath（相对 assetModelPath 的 .glb/.gltf 模型路径，存在则导入真实模型，否则回退图元），配套 license（CC0）与 sourceUrl（推荐下载来源）。",
  "normalization": {
    "size": "完整尺寸，单位米：size = [sx, sy, sz]（宽, 高, 深）",
    "part.size": "[dx, dy, dz]，是 [sx, sy, sz] 的比例（1 = 占满该轴）",
    "part.offset": "[ox, oy, oz]，是 [sx, sy, sz] 的比例，从底面中心（0,0,0）量起，y 向上",
    "part.radius": "圆柱/圆锥/球半径，是 min(sx, sz)/2 的比例",
    "part.height": "圆柱/圆锥高度，是 sy 的比例"
  },
